Options -Indexes
AddType application/manifest+json .webmanifest

# File ini berisi konfigurasi privat saat website dipasang di cPanel.
<FilesMatch "^\.(api-config\.php|access-bindings\.json|access-rate-limit\.json|access-tokens\.txt)$">
  Require all denied
</FilesMatch>

# Kompres aset teks jika modul tersedia di hosting.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

# File CSS/JS memakai nomor versi pada URL sehingga aman disimpan browser.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </Files>
</IfModule>
